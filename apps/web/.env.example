NEXT_PUBLIC_AGENT_URL=http://localhost:8080/api/agent
# Neon Auth URL (Neon Console > Auth), the same one the agent uses.
NEON_AUTH_BASE_URL=
# Signs the session cookie; 32+ random bytes: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
# The same comma-separated invite list as the agent: only these addresses get
# a sign-in code. OPENCOUCH_BETA_OPEN=true sends codes to anyone (local only).
OPENCOUCH_BETA_INVITES=
