OPENAI_API_KEY=
# Vercel AI Gateway key for Jev, which screens every turn. Required.
AI_GATEWAY_API_KEY=
# Neon Auth URL (Neon Console > Auth), where sign-ins are checked. Required.
# The web app uses the same value.
NEON_AUTH_BASE_URL=
# Comma-separated emails invited to the private beta. Unset means nobody gets
# past the waitlist; with OPENCOUCH_MODEL=test, OPENCOUCH_BETA_OPEN=true lets
# everyone in.
# OPENCOUCH_BETA_INVITES=you@example.com
# Any Pydantic AI model string, e.g. openai:gpt-6.1-sol
OPENCOUCH_MODEL=openai:gpt-6.1-sol
# Leave unset to keep sessions in memory (lost on restart).
# Run `docker compose up postgres` first if you enable this.
# OPENCOUCH_DATABASE_URL=postgresql://opencouch:opencouch@localhost:5433/opencouch
# Hard limit on one turn, including streaming the reply.
# OPENCOUCH_TURN_TIMEOUT_SECONDS=90
