OPENAI_API_KEY=
# Any Pydantic AI model string, e.g. openai:gpt-5.4-mini
OPENCOUCH_MODEL=openai:gpt-5.4-mini
# Leave unset to keep sessions in memory (lost on restart).
# Run `docker compose up postgres` first if you enable this.
# OPENCOUCH_DATABASE_URL=postgresql://opencouch:opencouch@localhost:5433/opencouch
