  {
    "id": "llm_multiturn_readiness_gate_then_opt_in",
    "dispatch_tier": "llm",
    "turns": [
      {
        "message": "I'm spiraling and I can't think straight. Please don't give me techniques right now.",
        "expected_response_style": "supportive",
        "assertions": {
          "must_not_include_any": [
            "exercise",
            "grounding",
            "5-4-3-2-1",
            "box breathing",
            "breathe with me"
          ],
          "max_sentences": 5
        }
      },
      {
        "message": "Can you just stay with me for a minute instead?",
        "expected_response_style": "supportive",
        "assertions": {
          "must_not_include_any": [
            "exercise",
            "grounding",
            "5-4-3-2-1",
            "box breathing"
          ],
          "max_sentences": 5
        }
      },
      {
        "message": "Okay, I think I could try one simple grounding step now.",
        "expected_response_style": "guided_exercise",
        "expected_exercise_active": true,
        "expected_exercise_type": "grounding_5_4_3_2_1",
        "expected_exercise_step_in": [
          0
        ],
        "assertions": {
          "must_include_any": [
            "grounding",
            "see around you",
            "see right now",
            "five things you can see"
          ],
          "max_sentences": 5
        }
      }
    ],
    "notes": "The agent should respect an initial 'not ready' boundary across turns, then move into an exercise once the user explicitly opts in."
  },
