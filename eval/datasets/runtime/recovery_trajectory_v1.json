{
  "name": "runtime_recovery_trajectory_v1",
  "description": "PersistentAgentRuntime recovery, liveness, and concurrency trajectories over the configured persistence backend.",
  "cases": [
    {
      "id": "same-thread-concurrent-turns-serialize",
      "description": "Two concurrent turns on the same thread should serialize behind the runtime thread lock and produce exactly two assistant turns.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "concurrent_turns",
          "turns": [
            {
              "thread_id": "{run_id}-same",
              "user_id": "{run_id}-user",
              "message": "First concurrent turn.",
              "scripted": {
                "response_text": "First scripted response."
              }
            },
            {
              "thread_id": "{run_id}-same",
              "user_id": "{run_id}-user",
              "message": "Second concurrent turn.",
              "scripted": {
                "response_text": "Second scripted response."
              }
            }
          ],
          "expected": {
            "result_count": 2,
            "exception_count": 0,
            "thread_states": [
              {
                "thread_id": "{run_id}-same",
                "exists": true,
                "status": "active",
                "transcript_length": 4,
                "assistant_turn_count": 2,
                "turn_count": 2
              }
            ]
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-same",
            "exists": true,
            "status": "active",
            "transcript_length": 4,
            "assistant_turn_count": 2,
            "turn_count": 2
          }
        ]
      }
    },
    {
      "id": "cross-thread-concurrent-turns-isolate",
      "description": "Concurrent turns on different threads should complete independently without transcript bleed.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "concurrent_turns",
          "turns": [
            {
              "thread_id": "{run_id}-alpha",
              "user_id": "{run_id}-user-a",
              "message": "Alpha thread message.",
              "scripted": {
                "response_text": "Alpha response."
              }
            },
            {
              "thread_id": "{run_id}-beta",
              "user_id": "{run_id}-user-b",
              "message": "Beta thread message.",
              "scripted": {
                "response_text": "Beta response."
              }
            }
          ],
          "expected": {
            "result_count": 2,
            "exception_count": 0,
            "thread_states": [
              {
                "thread_id": "{run_id}-alpha",
                "exists": true,
                "status": "active",
                "transcript_length": 2,
                "assistant_turn_count": 1,
                "turn_count": 1
              },
              {
                "thread_id": "{run_id}-beta",
                "exists": true,
                "status": "active",
                "transcript_length": 2,
                "assistant_turn_count": 1,
                "turn_count": 1
              }
            ]
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-alpha",
            "exists": true,
            "status": "active",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1
          },
          {
            "thread_id": "{run_id}-beta",
            "exists": true,
            "status": "active",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1
          }
        ]
      }
    },
    {
      "id": "failed-turn-leaves-interrupted-and-end-recovers",
      "description": "A graph failure should leave an interrupted session marker, block active reuse, and recover after explicit end_session.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "failed_turn",
          "thread_id": "{run_id}-failed",
          "user_id": "{run_id}-user",
          "message": "This turn should fail inside the graph.",
          "expected": {
            "exception_type": "RuntimeError",
            "status_after": "interrupted"
          }
        },
        {
          "type": "expect_turn_exception",
          "thread_id": "{run_id}-failed",
          "user_id": "{run_id}-user",
          "message": "Try to continue the interrupted session.",
          "expected_liveness": "active",
          "expected": {
            "exception_type": "SessionInterrupted",
            "status_after": "interrupted"
          }
        },
        {
          "type": "end_session",
          "thread_id": "{run_id}-failed",
          "expected": {
            "stored_arc_exists": false,
            "status_after": "absent"
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-failed",
            "exists": false,
            "status": "absent"
          }
        ]
      }
    },
    {
      "id": "rotation-required-blocks-active-reuse",
      "description": "A soft transcript limit should mark rotation_required, reject active-lease reuse, and clear after end_session.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "turn",
          "thread_id": "{run_id}-rotation",
          "user_id": "{run_id}-user",
          "message": "Open a short session.",
          "session_transcript_soft_limit": 1,
          "expected": {
            "status_after": "rotation_required"
          }
        },
        {
          "type": "expect_turn_exception",
          "thread_id": "{run_id}-rotation",
          "user_id": "{run_id}-user",
          "message": "This should require a rotated thread.",
          "expected_liveness": "active",
          "expected": {
            "exception_type": "SessionLeaseExpired",
            "status_after": "rotation_required"
          }
        },
        {
          "type": "end_session",
          "thread_id": "{run_id}-rotation",
          "expected": {
            "stored_arc_exists": false,
            "status_after": "absent"
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-rotation",
            "exists": true,
            "status": "absent",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1
          }
        ]
      }
    },
    {
      "id": "foreign-mutation-marker-blocks-and-recovers",
      "description": "A persisted mutation marker from another runtime should surface as interrupted until explicit finalization clears it.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "turn",
          "thread_id": "{run_id}-foreign",
          "user_id": "{run_id}-user",
          "message": "Create an active session.",
          "expected": {
            "status_after": "active"
          }
        },
        {
          "type": "inject_foreign_mutation",
          "thread_id": "{run_id}-foreign",
          "expected": {
            "status_after": "interrupted"
          }
        },
        {
          "type": "expect_turn_exception",
          "thread_id": "{run_id}-foreign",
          "user_id": "{run_id}-user",
          "message": "Try to continue after a foreign mutation.",
          "expected_liveness": "active",
          "expected": {
            "exception_type": "SessionInterrupted",
            "status_after": "interrupted"
          }
        },
        {
          "type": "end_session",
          "thread_id": "{run_id}-foreign",
          "expected": {
            "stored_arc_exists": false,
            "status_after": "absent"
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-foreign",
            "exists": true,
            "status": "absent",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1
          }
        ]
      }
    },
    {
      "id": "finalize-active-sessions-respects-exclusion",
      "description": "Runtime shutdown finalization should close locally owned active sessions while preserving externally owned channel sessions.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false,
        "auto_finalize_excluded_contains": ["external-owned"]
      },
      "steps": [
        {
          "type": "turn",
          "thread_id": "{run_id}-local-owned",
          "user_id": "{run_id}-user",
          "message": "Local runtime-owned session.",
          "expected": {
            "status_after": "active"
          }
        },
        {
          "type": "turn",
          "thread_id": "{run_id}-external-owned",
          "user_id": "{run_id}-user",
          "message": "Externally owned channel session.",
          "expected": {
            "status_after": "active"
          }
        },
        {
          "type": "finalize_active_sessions",
          "expected": {
            "thread_states": [
              {
                "thread_id": "{run_id}-local-owned",
                "exists": true,
                "status": "absent",
                "transcript_length": 2,
                "assistant_turn_count": 1,
                "turn_count": 1
              },
              {
                "thread_id": "{run_id}-external-owned",
                "exists": true,
                "status": "active",
                "transcript_length": 2,
                "assistant_turn_count": 1,
                "turn_count": 1
              }
            ]
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-local-owned",
            "exists": true,
            "status": "absent",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1
          },
          {
            "thread_id": "{run_id}-external-owned",
            "exists": true,
            "status": "active",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1
          }
        ]
      }
    }
  ]
}
