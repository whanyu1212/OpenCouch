            "therapeutic_dispatch": {
              "response_style": "supportive",
              "exercise_start_basis": "ambiguous_or_none",
              "therapeutic_approach": "none",
              "reasoning": "Supportive reflection is appropriate.",
              "confidence": "high"
            },
            "response_text": "That sounds tense. Let's slow it down and name what feels most immediate.",
            "semantic_extraction": {
              "facts": [],
              "reason": "no durable fact"
            },
            "procedural_extraction": {
              "rules": [],
              "reason": "no style rule"
            }
          },
          "expected": {
            "route": "therapeutic",
            "response_style": "supportive",
            "transcript_length": 2,
            "assistant_turn_count": 1,
            "turn_count": 1,
            "status_after": "active"
          }
        },
        {
          "type": "reopen_runtime"
        },
        {
          "type": "turn",
          "thread_id": "{run_id}-resume",
          "user_id": "{run_id}-user",
          "message": "Can you keep going from what I said?",
          "scripted": {
            "crisis": {
              "level": 0,
              "confidence": "high",
              "reason": "safe continuation",
              "needs_crisis_response": false,
              "needs_clarification": false
            },
            "turn_dispatch": {
              "route": "therapeutic",
