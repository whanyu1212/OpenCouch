              "confidence": "high"
            },
            "response_text": "Yes. You were feeling tense about tomorrow; let's stay with the part that feels hardest.",
            "semantic_extraction": {
              "facts": [],
              "reason": "no durable fact"
            },
            "procedural_extraction": {
              "rules": [],
              "reason": "no style rule"
            }
          },
          "expected": {
            "route": "therapeutic",
            "transcript_length": 4,
            "assistant_turn_count": 2,
            "turn_count": 2,
            "status_after": "active"
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-resume",
