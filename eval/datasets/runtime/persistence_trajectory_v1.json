      "steps": [
        {
          "type": "turn",
          "thread_id": "{run_id}-resume",
          "user_id": "{run_id}-user",
          "message": "I feel tense about tomorrow.",
          "scripted": {
            "crisis": {
              "level": 0,
              "confidence": "high",
              "reason": "ordinary anxiety without crisis risk",
