{
  "name": "memory_recall_robustness_v1",
  "description": "Postgres-first runtime trajectories for realistic memory recall phrasing, correction, and no-memory boundaries.",
  "cases": [
    {
      "id": "indirect-support-person-recall",
      "description": "A fresh-thread indirect question should recall the relevant support person without needing exact saved wording.",
      "modes": ["scripted", "live"],
      "runtime": {
        "memory_mode": "local",
        "extract_in_foreground": true,
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "memory_seed": {
        "owners": [
          {
            "owner_id": "{run_id}-user",
            "seed": {
              "semantic_facts": [
                {
                  "id": "fact-sarah-support",
                  "category": "relationship",
                  "predicate": "KNOWS",
                  "object_type": "Person",
                  "object_identifier": "Sarah",
                  "evidence_quote": "My sister Sarah helps when panic starts."
                }
              ],
              "proactive_recall_enabled": true
            }
          }
        ]
      },
      "steps": [
        {
          "type": "turn",
          "thread_id": "{run_id}-indirect",
          "user_id": "{run_id}-user",
          "message": "I'm getting that panic feeling again. Who did I say I reach out to when panic starts?",
          "scripted": {
            "crisis": {
              "level": 0,
              "confidence": "high",
              "reason": "safe recall request about support context",
              "needs_crisis_response": false,
              "needs_clarification": false
            },
            "turn_dispatch": {
              "route": "therapeutic",
              "reasoning": "The user asks for support around remembered panic context.",
              "confidence": "high",
              "active_flow_action": "none"
            },
            "therapeutic_dispatch": {
              "response_style": "supportive",
              "exercise_start_basis": "ambiguous_or_none",
              "therapeutic_approach": "pfa",
              "reasoning": "Brief support with recalled context fits.",
              "confidence": "high"
            },
            "response_text": "You said Sarah is the person who helps when panic starts. If it feels okay, send her one clear text now.",
            "semantic_extraction": {
              "facts": [],
              "reason": "no new durable fact"
            },
            "procedural_extraction": {
              "rules": [],
              "reason": "no style rule"
            }
          },
          "expected": {
            "route": "therapeutic",
            "response_style": "supportive",
            "status_after": "active",
            "working_memory_count_min": 1,
            "working_memory_contains": ["Sarah", "panic starts"],
            "semantic_hits_min": 1,
            "response_text_contains": ["Sarah"],
            "transcript_length": 2,
            "turn_count": 1
          }
        }
      ],
      "expected": {
        "memory_snapshots": [
          {
            "owner_id": "{run_id}-user",
            "active_facts_contain": ["Sarah"]
          }
        ],
        "thread_states": [
          {
            "thread_id": "{run_id}-indirect",
            "exists": true,
            "status": "active",
            "transcript_length": 2,
            "turn_count": 1
          }
        ]
      },
      "rubric": {
        "min_judge_score": 0.78,
        "dimensions": [
          {
            "name": "indirect_recall",
            "question": "Does the assistant answer the indirect recall question using the saved Sarah support-person memory without sounding mechanical?",
            "weight": 1.2
          },
          {
            "name": "support_quality",
            "question": "Does the response give a calm next step for panic support?",
            "weight": 1.0
          }
        ]
      }
    },
