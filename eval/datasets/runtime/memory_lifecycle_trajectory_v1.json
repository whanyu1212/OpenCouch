{
  "name": "memory_lifecycle_trajectory_v1",
  "description": "Postgres-first text-agent trajectories for long-term memory lifecycle behavior across fresh threads.",
  "cases": [
    {
      "id": "semantic-write-recall-fresh-thread",
      "description": "A durable support-person fact shared in one thread should be written and recalled on a fresh thread for the same user.",
      "modes": ["scripted", "live"],
      "runtime": {
        "memory_mode": "local",
        "extract_in_foreground": true,
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "memory_seed": {
        "owners": [
          {
            "owner_id": "{run_id}-user",
            "seed": {
              "proactive_recall_enabled": true
            }
          }
        ]
      },
      "steps": [
        {
          "type": "turn",
          "thread_id": "{run_id}-write",
          "user_id": "{run_id}-user",
          "message": "A stable support fact about me: my sister Sarah helps when panic starts.",
          "scripted": {
            "crisis": {
              "level": 0,
              "confidence": "high",
              "reason": "safe support-person context",
              "needs_crisis_response": false,
              "needs_clarification": false
            },
            "turn_dispatch": {
              "route": "therapeutic",
              "reasoning": "The user is sharing support context.",
              "confidence": "high",
              "active_flow_action": "none"
            },
            "therapeutic_dispatch": {
              "response_style": "supportive",
              "exercise_start_basis": "ambiguous_or_none",
              "therapeutic_approach": "none",
              "reasoning": "Supportive acknowledgement fits.",
              "confidence": "high"
            },
            "response_text": "It is useful to know that Sarah is someone who helps when panic starts.",
            "semantic_extraction": {
              "facts": [
                {
                  "category": "relationship",
                  "subject": {
                    "type": "User",
                    "identifier": "{run_id}-user"
                  },
                  "predicate": "KNOWS",
                  "object": {
                    "type": "Person",
                    "identifier": "Sarah"
                  },
                  "evidence_quote": "my sister Sarah helps when panic starts",
                  "confidence": "high",
                  "source_session_id": "{run_id}-write",
                  "source_turn_index": 0
                }
              ],
              "reason": "stored named support-person relationship"
            },
            "procedural_extraction": {
              "rules": [],
              "reason": "no style rule"
            }
          },
          "expected": {
            "status_after": "active",
            "transcript_length": 2,
            "turn_count": 1
          }
        },
        {
          "type": "turn",
          "thread_id": "{run_id}-recall",
          "user_id": "{run_id}-user",
          "message": "Panic starts again and I need Sarah's help. Help me use that support.",
          "scripted": {
            "crisis": {
              "level": 0,
              "confidence": "high",
              "reason": "panic support request without crisis intent",
              "needs_crisis_response": false,
              "needs_clarification": false
            },
            "turn_dispatch": {
              "route": "therapeutic",
              "reasoning": "The user asks for emotional support using known context.",
              "confidence": "high",
              "active_flow_action": "none"
            },
            "therapeutic_dispatch": {
              "response_style": "supportive",
              "exercise_start_basis": "ambiguous_or_none",
              "therapeutic_approach": "none",
              "reasoning": "Supportive response fits.",
              "confidence": "high"
            },
            "response_text": "Sarah is the support person you mentioned. If it feels safe, text or call her now and stay with one grounding cue while you wait.",
            "semantic_extraction": {
              "facts": [],
              "reason": "no new durable fact"
            },
            "procedural_extraction": {
              "rules": [],
              "reason": "no new style rule"
            }
          },
          "expected": {
            "status_after": "active",
            "working_memory_count": 1,
            "working_memory_contains": ["Sarah"],
            "semantic_hits": 1,
            "response_text_contains": ["Sarah"],
            "transcript_length": 2,
            "turn_count": 1
          }
        }
      ],
      "expected": {
        "memory_snapshots": [
          {
            "owner_id": "{run_id}-user",
            "semantic_count": 1,
            "active_semantic_count": 1,
            "facts_contain": ["Sarah"],
            "active_facts_contain": ["Sarah"]
          }
        ],
        "thread_states": [
          {
            "thread_id": "{run_id}-recall",
            "exists": true,
            "transcript_length": 2,
            "turn_count": 1,
            "status": "active"
          }
        ]
      },
      "rubric": {
        "min_judge_score": 0.78,
        "dimensions": [
          {
            "name": "cross_thread_recall",
            "question": "Does the fresh-thread response use the written support-person memory naturally and only because it is relevant?",
            "weight": 1.2
          },
          {
            "name": "support_quality",
            "question": "Does the assistant give calm, immediately usable panic support?",
            "weight": 1.0
          }
        ]
      }
    },
    {
