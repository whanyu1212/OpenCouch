{
  "name": "therapeutic_contract_v1",
  "description": "CI-safe contract checks for the simplified therapeutic subgraph.",
  "cases": [
    {
      "id": "supportive-basic",
      "description": "A normal therapeutic turn routes to the shared response node.",
      "message": "I had a hard day at work and feel pretty drained.",
      "scripted": {
        "dispatch": {
          "response_style": "supportive",
          "exercise_start_basis": "ambiguous_or_none",
          "therapeutic_approach": "none"
        },
        "response_text": "That sounds like a heavy day. I can stay with you for a moment."
      },
      "expected": {
        "response_style": "supportive",
        "therapeutic_approach": "none",
        "response_text_contains": ["heavy day"],
        "exercise_state": {},
        "routing_decision": "supportive"
      }
    },
    {
      "id": "guided-start-grounding",
      "description": "A guided-exercise route starts a selected exercise at step 0.",
      "message": "Can you walk me through a grounding exercise?",
      "scripted": {
        "dispatch": {
          "response_style": "guided_exercise",
          "exercise_start_basis": "explicit_user_request",
          "therapeutic_approach": "dbt_skills"
        },
        "exercise_selection": "grounding_5_4_3_2_1",
        "response_text": "Let's begin 5-4-3-2-1 grounding with what you can see."
      },
      "expected": {
        "response_style": "guided_exercise",
        "therapeutic_approach": "dbt_skills",
        "response_text_contains": ["5-4-3-2-1"],
        "exercise_state": {
          "exercise_type": "grounding_5_4_3_2_1",
          "exercise_step": 0,
          "exercise_step_id": "see",
          "exercise_therapeutic_approach": "dbt_skills"
        },
        "routing_decision": "guided_exercise/dbt_skills"
      }
    },
    {
      "id": "guided-advance-pinned-approach",
      "description": "Continuing an active exercise advances the step and preserves the pinned approach.",
      "message": "I can see my desk, the window, my laptop, a plant, and a cup.",
