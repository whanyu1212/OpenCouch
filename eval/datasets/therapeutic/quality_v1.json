{
  "name": "therapeutic_quality_v1",
  "description": "Response-quality checks for concise, non-menu therapeutic turns.",
  "cases": [
    {
      "id": "supportive-concise-grounded",
      "description": "Supportive response should be concise, validating, and not over-directive.",
      "message": "I am exhausted and feel like I failed today.",
      "scripted": {
        "dispatch": {
          "response_style": "supportive",
          "exercise_start_basis": "ambiguous_or_none",
          "therapeutic_approach": "none"
        },
        "response_text": "That sounds exhausting. It makes sense that your system feels worn down after a day like that. What feels most needed for the next few minutes?"
      },
      "expected": {
        "response_style": "supportive",
        "response_text_non_empty": true,
        "min_quality_score": 0.85
      },
      "rubric": {
        "max_words": 55,
        "max_questions": 1,
        "forbidden_phrases": ["you should", "diagnose", "as a therapist"],
        "must_not_offer_menu": true
      }
    },
    {
      "id": "guided-start-specific-step",
      "description": "Guided exercise start should give one concrete first step, not a menu.",
      "message": "Can we do 5-4-3-2-1 grounding?",
      "scripted": {
        "dispatch": {
          "response_style": "guided_exercise",
          "exercise_start_basis": "explicit_user_request",
          "therapeutic_approach": "dbt_skills"
        },
        "exercise_selection": "grounding_5_4_3_2_1",
        "response_text": "Let's begin 5-4-3-2-1 grounding. Take one breath, then name five things you can see around you."
      },
      "expected": {
        "response_style": "guided_exercise",
        "response_text_non_empty": true,
        "exercise_state": {
          "exercise_type": "grounding_5_4_3_2_1",
          "exercise_step": 0,
          "exercise_step_id": "see"
        },
        "min_quality_score": 0.85
      },
      "rubric": {
        "max_words": 40,
        "max_questions": 0,
        "required_phrases": ["five things", "see"],
        "forbidden_phrases": ["which exercise", "choose one", "option"],
        "must_not_offer_menu": true
      }
    },
    {
      "id": "guided-hold-does-not-advance",
      "description": "A hold response should preserve the current step and make it easier to continue.",
      "message": "Maybe the chair, but I am still stuck.",
      "state": {
        "therapeutic_approach": "dbt_skills",
        "exercise_state": {
          "exercise_type": "grounding_5_4_3_2_1",
          "exercise_step": 0,
          "exercise_step_id": "see",
          "exercise_version": 1,
          "exercise_therapeutic_approach": "dbt_skills"
        }
      },
      "scripted": {
        "dispatch": {
          "response_style": "guided_exercise",
          "exercise_start_basis": "explicit_user_request",
          "therapeutic_approach": "dbt_skills"
        },
        "step_state": "hold",
        "response_text": "The chair counts. Stay with seeing for one more moment and name anything with a color or shape."
      },
      "expected": {
        "response_style": "guided_exercise",
        "response_text_non_empty": true,
        "exercise_state": {
          "exercise_type": "grounding_5_4_3_2_1",
          "exercise_step": 0,
          "exercise_step_id": "see"
        },
        "min_quality_score": 0.85
      },
      "rubric": {
        "max_words": 35,
        "max_questions": 0,
        "required_phrases": ["chair"],
        "forbidden_phrases": ["next step", "four things you can hear"],
        "must_not_offer_menu": true
      }
    }
  ]
}
