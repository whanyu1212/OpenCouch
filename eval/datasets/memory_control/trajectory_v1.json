    {
      "id": "preference-save-affects-load-memory",
      "description": "A saved style preference should be persisted and visible to later load-memory turns.",
      "turns": [
        {
          "message": "Remember that I prefer direct answers when I am spiraling.",
          "scripted": {
            "decision": {
              "route": "memory_control",
              "memory_action_type": "save_preference",
              "preference_text": "direct answers when I am spiraling",
              "reasoning": "The user asks to save a response-style preference.",
              "confidence": "high"
            },
            "preference_rule_text": "You prefer direct answers when you are spiraling."
          },
          "expected": {
            "goto": "memory_control_node",
            "route": "memory_control",
            "memory_action_type": "save_preference",
            "memory_action_preference_text_contains": "direct answers",
            "response_style": "memory_control",
            "response_text_contains": ["Saved:", "direct answers"],
            "store_after": {
              "rule_count": 1,
              "rules_contain": ["direct answers"]
            }
          }
        },
        {
          "message": "I am spiraling about tomorrow's meeting.",
          "scripted": {
            "decision": {
              "route": "therapeutic",
              "reasoning": "The user asks for emotional support.",
              "confidence": "high"
            }
          },
          "expected": {
            "goto": "load_memory_node",
            "route": "therapeutic",
            "load_memory_rules_contain": ["direct answers"],
            "store_after": {
              "rule_count": 1,
              "rules_contain": ["direct answers"]
            }
          }
        }
      ],
      "expected": {
        "final_store": {
          "rule_count": 1,
          "rules_contain": ["direct answers"]
        }
      }
    },
    {
