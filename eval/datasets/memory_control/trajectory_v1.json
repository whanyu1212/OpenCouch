{
  "name": "memory_control_trajectory_v1",
  "description": "Multi-turn memory-control trajectories with seeded long-term memory.",
  "cases": [
    {
      "id": "inspect-vs-support-boundary",
      "description": "Memory-adjacent support should stay therapeutic, while explicit inspection should list saved memory.",
      "memory_seed": {
        "semantic_facts": [
          {
            "id": "fact-presentations",
            "category": "trigger",
            "predicate": "WORRIES_ABOUT",
            "object_type": "Event",
            "object_identifier": "presentations",
            "evidence_quote": "Presentations make me anxious, especially when senior leaders are in the room."
          }
        ],
        "episodic_sessions": [
          {
            "id": "session-presentation-cbt",
            "session_id": "prior-presentation-cbt",
            "primary_themes": ["presentation anxiety", "catastrophic predictions"],
            "summary": "The user explored presentation anxiety, noticed a catastrophic prediction about freezing, and planned to test it with one short practice run.",
            "approach_used": "cbt"
          }
        ],
        "procedural_rules": [
          {
            "rule": "You prefer concise, direct responses when you are panicking.",
            "evidence": ["Please keep it short when I am panicking."]
          }
        ],
        "proactive_recall_enabled": true
      },
      "turns": [
        {
          "message": "Do you remember I get anxious before presentations? It is happening again.",
          "scripted": {
            "decision": {
              "route": "therapeutic",
              "reasoning": "The user references prior context while asking for support.",
              "confidence": "high"
            }
          },
          "expected": {
            "goto": "load_memory_node",
            "route": "therapeutic",
            "load_memory_proactive_recall_enabled": true,
            "load_memory_rules_contain": ["concise, direct"],
            "store_after": {
              "semantic_count": 1,
              "episodic_count": 1,
              "rule_count": 1,
              "facts_contain": ["Presentations make me anxious"]
            }
          }
        },
        {
          "message": "What do you remember about my anxiety?",
          "scripted": {
            "decision": {
              "route": "memory_control",
              "memory_action_type": "list",
              "reasoning": "The user asks to inspect saved assistant memory.",
              "confidence": "high"
            }
          },
          "expected": {
            "goto": "memory_control_node",
            "route": "memory_control",
            "memory_action_type": "list",
            "response_style": "memory_control",
            "response_text_contains": ["Presentations make me anxious", "presentation anxiety"],
            "pending_action_is_null": true,
            "store_after": {
              "semantic_count": 1,
              "episodic_count": 1,
              "rule_count": 1
            }
          }
        }
      ],
      "expected": {
        "final_store": {
          "semantic_count": 1,
          "episodic_count": 1,
          "rule_count": 1,
          "facts_contain": ["Presentations make me anxious"]
        }
      }
    },
    {
      "id": "delete-confirmation-lifecycle",
      "description": "Deletion should be pending first, committed only after explicit confirmation, and absent afterward.",
      "memory_seed": {
        "semantic_facts": [
          {
            "id": "fact-presentations",
            "category": "trigger",
            "predicate": "WORRIES_ABOUT",
            "object_type": "Event",
            "object_identifier": "presentations",
            "evidence_quote": "Presentations make me anxious."
          }
        ]
      },
      "turns": [
        {
          "message": "Forget what you saved about presentations.",
          "scripted": {
            "decision": {
              "route": "memory_control",
              "memory_action_type": "forget_by_query",
              "query": "presentations",
              "reasoning": "The user asks to delete saved memory by topic.",
              "confidence": "high"
            }
          },
          "expected": {
            "goto": "memory_control_node",
            "route": "memory_control",
            "memory_action_type": "forget_by_query",
            "memory_action_query_contains": "presentations",
            "response_style": "memory_control",
            "response_text_contains": ["Do you want me to delete it?"],
            "pending_action_type": "delete",
            "pending_target_kind": "fact",
            "store_after": {
              "semantic_count": 1,
              "facts_contain": ["Presentations make me anxious"]
            }
          }
        },
        {
          "message": "Yes, delete it.",
          "scripted": {
            "decision": {
              "route": "memory_control",
              "memory_action_type": "confirm_pending",
              "reasoning": "The user confirms the pending deletion.",
              "confidence": "high"
            }
          },
          "expected": {
            "goto": "memory_control_node",
            "route": "memory_control",
            "memory_action_type": "confirm_pending",
            "response_style": "memory_control",
            "response_text_contains": ["Deleted that saved fact"],
            "pending_action_is_null": true,
            "store_after": {
              "semantic_count": 0,
              "facts_absent": ["Presentations make me anxious"]
            }
          }
        },
        {
          "message": "What do you remember about presentations now?",
          "scripted": {
            "decision": {
              "route": "memory_control",
              "memory_action_type": "list",
              "reasoning": "The user asks to inspect saved assistant memory.",
              "confidence": "high"
            }
          },
          "expected": {
            "goto": "memory_control_node",
            "route": "memory_control",
            "memory_action_type": "list",
            "response_style": "memory_control",
            "response_text_contains": ["don't have any saved facts"],
            "response_text_not_contains": ["Presentations make me anxious"],
            "pending_action_is_null": true,
            "store_after": {
              "semantic_count": 0,
              "facts_absent": ["Presentations make me anxious"]
            }
          }
        }
      ],
      "expected": {
        "final_store": {
          "semantic_count": 0,
          "facts_absent": ["Presentations make me anxious"]
        }
      }
    },
