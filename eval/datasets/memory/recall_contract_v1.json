{
  "name": "memory_recall_contract_v1",
  "description": "Direct load-memory recall contracts for semantic, episodic, procedural, toggle, and embedding fallback behavior.",
  "cases": [
    {
      "id": "empty-store-skips-searchable-retrieval",
      "description": "A user with no saved semantic or episodic memory should skip searchable retrieval while still returning recall metadata.",
      "query": "I feel anxious tonight and need help slowing down.",
      "expected": {
        "working_memory_count": 0,
        "procedural_count": 0,
        "proactive_recall_enabled": false,
        "proactive_recall": false,
        "semantic_store_size": 0,
        "episodic_store_size": 0,
        "semantic_hits": 0,
        "episodic_hits": 0,
        "retrieval_path": "skipped_empty_store"
      }
    },
    {
      "id": "semantic-relevant-fact-excludes-decoy",
      "description": "Relevant semantic memory should be retrieved while unrelated semantic decoys stay out.",
      "query": "Panic support when it starts",
      "memory_seed": {
        "semantic_facts": [
          {
            "id": "fact-sarah-support",
            "category": "relationship",
            "predicate": "KNOWS",
            "object_type": "Person",
            "object_identifier": "Sarah",
            "evidence_quote": "My sister Sarah helps when panic starts."
          },
          {
            "id": "fact-cooking-decoy",
            "category": "preference",
            "predicate": "USES",
            "object_type": "Event",
            "object_identifier": "Sunday cooking",
            "evidence_quote": "I like cooking pasta on Sundays."
          }
        ],
        "proactive_recall_enabled": true
      },
      "expected": {
        "working_memory_count": 1,
        "working_memory_contains": ["Sarah", "panic starts"],
        "working_memory_not_contains": ["pasta", "Sundays"],
        "semantic_store_size": 2,
        "semantic_hits": 1,
        "episodic_hits": 0,
        "proactive_recall_enabled": true,
        "retrieval_path": "token_recall"
      }
    },
    {
      "id": "semantic-filters-dormant-and-superseded-records",
      "description": "Dormant and superseded semantic facts should not enter working memory even when they lexically match.",
      "query": "work presentations anxiety",
      "memory_seed": {
        "semantic_facts": [
          {
            "id": "fact-active-presentations",
            "category": "trigger",
            "predicate": "WORRIES_ABOUT",
            "object_type": "Concern",
            "object_identifier": "work presentations",
            "evidence_quote": "Work presentations make me anxious before senior reviews."
          },
          {
            "id": "fact-dormant-deadlines",
            "category": "trigger",
            "predicate": "WORRIES_ABOUT",
            "object_type": "Concern",
            "object_identifier": "work deadlines",
            "evidence_quote": "Work deadlines used to make me anxious.",
            "dormant_at": "2026-05-01T00:00:00Z"
          },
          {
            "id": "fact-superseded-presentations",
            "category": "trigger",
            "predicate": "WORRIES_ABOUT",
            "object_type": "Concern",
            "object_identifier": "work presentations",
            "evidence_quote": "Work presentations are impossible for me.",
            "superseded_by": "fact-active-presentations"
          }
        ]
      },
      "expected": {
        "working_memory_count": 1,
        "working_memory_contains": ["senior reviews"],
        "working_memory_not_contains": ["deadlines", "impossible"],
        "semantic_store_size": 3,
        "semantic_hits": 1,
        "retrieval_path": "token_recall"
      }
    },
    {
      "id": "first-turn-episodic-catch-up",
      "description": "The first turn should include the latest episodic summary even when the query has little lexical overlap.",
      "query": "I am back and unsure where to begin today.",
      "is_first_turn": true,
      "memory_seed": {
        "episodic_sessions": [
          {
            "id": "session-old-sleep",
            "session_id": "old-sleep-session",
            "primary_themes": ["sleep"],
            "summary": "The user explored a sleep routine and planned to reduce late caffeine.",
            "created_at": "2026-04-20T09:00:00Z"
          },
          {
            "id": "session-recent-presentation",
            "session_id": "recent-presentation-session",
            "primary_themes": ["presentation anxiety", "catastrophic predictions"],
            "summary": "The user practiced a short presentation run and identified a catastrophic prediction about freezing.",
            "approach_used": "cbt",
            "created_at": "2026-05-08T09:00:00Z"
          }
        ]
      },
      "expected": {
        "working_memory_count": 1,
        "working_memory_contains": ["presentation run", "freezing"],
        "working_memory_not_contains": ["late caffeine"],
        "semantic_hits": 0,
        "episodic_hits": 1,
        "retrieval_path": "token_recall"
      }
    },
    {
      "id": "later-turn-episodic-query-recall",
      "description": "After the first turn, episodic retrieval should be query-driven rather than automatic catch-up.",
      "query": "presentation practice freezing",
      "is_first_turn": false,
      "memory_seed": {
        "episodic_sessions": [
          {
            "id": "session-old-sleep",
            "session_id": "old-sleep-session",
            "primary_themes": ["sleep"],
            "summary": "The user explored a sleep routine and planned to reduce late caffeine.",
            "created_at": "2026-04-20T09:00:00Z"
          },
          {
            "id": "session-recent-presentation",
            "session_id": "recent-presentation-session",
            "primary_themes": ["presentation anxiety", "catastrophic predictions"],
            "summary": "The user practiced a short presentation run and identified a catastrophic prediction about freezing.",
            "approach_used": "cbt",
            "created_at": "2026-05-08T09:00:00Z"
          }
        ]
      },
      "expected": {
        "working_memory_count": 1,
        "working_memory_contains": ["presentation run", "freezing"],
        "working_memory_not_contains": ["late caffeine"],
        "semantic_hits": 0,
        "episodic_hits": 1,
        "retrieval_path": "token_recall"
      }
    },
    {
      "id": "procedural-rules-load-with-recall-off",
      "description": "Procedural rules should load even when proactive recall is off and no searchable memory exists.",
      "query": "I am overwhelmed. Help me keep this simple.",
      "memory_seed": {
        "procedural_rules": [
          {
            "rule": "You prefer short, direct replies when overwhelmed.",
            "evidence": ["When I am overwhelmed, keep it short and direct."]
          }
        ],
        "proactive_recall_enabled": false
      },
      "expected": {
        "working_memory_count": 0,
        "procedural_count": 1,
        "procedural_rules_contain": ["short, direct"],
        "proactive_recall_enabled": false,
        "proactive_recall": false,
        "retrieval_path": "skipped_empty_store"
      }
    },
    {
      "id": "recall-toggle-on-surfaces-without-searchable-memory",
      "description": "The proactive recall toggle should be visible even when there are no semantic or episodic records.",
      "query": "Can you help me sort through this week?",
      "memory_seed": {
        "proactive_recall_enabled": true
      },
      "expected": {
        "working_memory_count": 0,
        "procedural_count": 0,
        "proactive_recall_enabled": true,
        "proactive_recall": true,
        "retrieval_path": "skipped_empty_store"
      }
    },
    {
      "id": "embedding-failure-falls-back-to-token-recall",
      "description": "A query embedding failure should not block recall; lexical recall should still retrieve relevant memories.",
      "query": "Panic support when it starts",
      "embedding_provider": "failing",
      "memory_seed": {
        "semantic_facts": [
          {
            "id": "fact-sarah-support",
            "category": "relationship",
            "predicate": "KNOWS",
            "object_type": "Person",
            "object_identifier": "Sarah",
            "evidence_quote": "My sister Sarah helps when panic starts."
          }
        ]
      },
      "expected": {
        "working_memory_count": 1,
        "working_memory_contains": ["Sarah", "panic starts"],
        "semantic_hits": 1,
        "retrieval_path": "token_recall_after_embed_error"
      }
    }
  ]
}
