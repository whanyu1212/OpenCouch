          "reason": "explicit durable style preference"
        }
      },
      "expected": {
        "count": 1,
        "rules": [
          {
            "rule_contains": ["You", "shorter"],
            "evidence_contains": ["keep your responses shorter"],
            "forbidden_rule_contains": ["User ", "Avoid ", "Don't "]
          }
        ]
      }
