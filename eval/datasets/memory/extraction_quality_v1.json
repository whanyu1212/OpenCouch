      "id": "semantic-relationship-sister-role",
      "layer": "semantic",
      "description": "Extract a named relationship only when the role is explicit.",
      "message": "My sister Sarah lives nearby and checks on me after panic attacks.",
      "scripted": {
        "semantic_extraction": {
          "facts": [
            {
              "category": "relationship",
              "subject": {"type": "User", "identifier": "user-1"},
              "predicate": "KNOWS",
              "object": {"type": "Person", "identifier": "sister Sarah"},
              "evidence_quote": "My sister Sarah lives nearby and checks on me after panic attacks.",
              "confidence": "high",
              "source_session_id": "eval-session",
              "source_turn_index": 0
            }
          ],
          "reason": "explicit durable relationship fact"
        }
      },
      "expected": {
        "count": 1,
        "facts": [
          {
            "category": "relationship",
            "predicate": "KNOWS",
            "object_type": "Person",
            "object_contains": ["Sarah"],
            "evidence_contains": ["sister Sarah"]
          }
        ]
      }
    },
