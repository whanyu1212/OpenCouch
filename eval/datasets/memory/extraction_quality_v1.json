      "id": "procedural-explicit-shorter-responses",
      "layer": "procedural",
      "description": "Write explicit durable style preference.",
      "message": "Going forward, keep your responses shorter. I do not need paragraphs.",
      "scripted": {
        "procedural_extraction": {
          "rules": [
            {
              "rule": "You prefer shorter responses without long paragraphs.",
