{
  "name": "text_surface_runtime_v1",
  "description": "Text API and CLI surface checks against PersistentAgentRuntime using the configured persistence backend.",
  "cases": [
    {
      "id": "api-chat-history-end-feedback",
      "description": "The HTTP API should run a turn, expose persisted history, record feedback on end, and report memory status.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "api_chat",
          "thread_id": "{run_id}-api",
          "user_id": "{run_id}-user",
          "message": "I need a little support before bed.",
          "expected": {
            "status_code": 200,
            "json_contains": ["scripted runtime response", "therapeutic"]
          }
        },
        {
          "type": "api_history",
          "thread_id": "{run_id}-api",
          "expected": {
            "status_code": 200,
            "message_count": 2
          }
        },
        {
          "type": "api_end",
          "thread_id": "{run_id}-api",
          "feedback": "positive",
          "expected": {
            "status_code": 200,
            "feedback_count": 1,
            "status_after": "absent"
          }
        },
        {
          "type": "api_memory_status",
          "thread_id": "{run_id}-api",
          "user_id": "{run_id}-user",
          "expected": {
            "status_code": 200,
            "json_contains": ["session_feedback_count", "{run_id}-user"]
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-api",
            "exists": true,
            "status": "absent",
            "history_count": 2,
            "feedback_count": 1
          }
        ]
      }
    },
    {
      "id": "cli-end-records-feedback-and-finalizes",
      "description": "The CLI /end command should record explicit feedback, finalize the runtime session, and stop the loop.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "seed_turn",
          "thread_id": "{run_id}-cli",
          "user_id": "{run_id}-user",
          "message": "Seed the CLI session before ending.",
          "expected": {
            "status_after": "active",
            "transcript_length": 2
          }
        },
        {
          "type": "cli_command",
          "thread_id": "{run_id}-cli",
          "user_id": "{run_id}-user",
          "command": "/end",
          "feedback": "skip",
          "expected": {
            "should_continue": false,
            "feedback_count": 1,
            "status_after": "absent"
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-cli",
            "exists": true,
            "status": "absent",
            "history_count": 2,
            "feedback_count": 1
          }
        ]
      }
    },
    {
      "id": "api-chat-llm-failure-interrupts-and-recovers",
      "description": "HTTP chat failures should surface as explicit errors, mark the runtime session interrupted, block retries, and recover after /end.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "api_chat",
          "thread_id": "{run_id}-http-fail",
          "user_id": "{run_id}-user",
          "message": "I need support, but make the classifier fail.",
          "scripted": {
            "raise_on_schema": "CrisisAssessmentSchema",
            "error": "scripted crisis classifier failure"
          },
          "expected": {
            "status_code": 500,
            "error_code": "agent_turn_failed",
            "status_after": "interrupted",
            "has_active_session": false,
            "json_contains": [
              "agent_turn_failed",
              "scripted crisis classifier failure"
            ]
          }
        },
        {
          "type": "api_session_status",
          "thread_id": "{run_id}-http-fail",
          "expected": {
            "status_code": 200,
            "status_after": "interrupted",
            "has_active_session": false
          }
        },
        {
          "type": "api_chat",
          "thread_id": "{run_id}-http-fail",
          "user_id": "{run_id}-user",
          "message": "Trying again before recovery should be rejected.",
          "expected": {
            "status_code": 409,
            "error_code": "session_interrupted",
            "status_after": "interrupted",
            "has_active_session": false,
            "json_contains": ["session_interrupted"]
          }
        },
        {
          "type": "api_end",
          "thread_id": "{run_id}-http-fail",
          "expected": {
            "status_code": 200,
            "status_after": "absent",
            "has_active_session": false
          }
        },
        {
          "type": "api_chat",
          "thread_id": "{run_id}-http-fail",
          "user_id": "{run_id}-user",
          "message": "Now continue after explicit recovery.",
          "scripted": {
            "response_text": "recovered surface reply"
          },
          "expected": {
            "status_code": 200,
            "status_after": "active",
            "has_active_session": true,
            "json_contains": ["recovered surface reply"]
          }
        }
      ],
      "expected": {
        "thread_states": [
          {
            "thread_id": "{run_id}-http-fail",
            "exists": true,
            "status": "active",
            "has_active_session": true,
            "history_count": 3,
            "feedback_count": 0
          }
        ]
      }
    },
    {
      "id": "api-grounded-lookup-provider-failure-interrupts",
      "description": "Grounded lookup provider failures should not become unverified fallback replies.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "api_chat",
          "thread_id": "{run_id}-lookup-fail",
          "user_id": "{run_id}-user",
          "message": "Can you look up reputable panic attack resources?",
          "scripted": {
            "turn_dispatch": {
              "route": "grounded_lookup",
              "query": "reputable panic attack resources",
              "reasoning": "The user asked for external resources.",
              "confidence": "high"
            },
            "raise_on_schema": "LookupPreflightDecision",
            "error": "scripted grounded lookup failure"
          },
          "expected": {
            "status_code": 500,
            "error_code": "agent_turn_failed",
            "status_after": "interrupted",
            "has_active_session": false,
            "json_contains": [
              "agent_turn_failed",
              "scripted grounded lookup failure"
            ]
          }
        },
        {
          "type": "api_chat",
          "thread_id": "{run_id}-lookup-fail",
          "user_id": "{run_id}-user",
          "message": "Retrying before ending should still be blocked.",
          "expected": {
            "status_code": 409,
            "error_code": "session_interrupted",
            "status_after": "interrupted",
            "has_active_session": false,
            "json_contains": ["session_interrupted"]
          }
        },
        {
          "type": "api_end",
          "thread_id": "{run_id}-lookup-fail",
          "expected": {
            "status_code": 200,
            "status_after": "absent",
            "has_active_session": false
          }
        }
      ]
    },
    {
      "id": "websocket-stream-failure-surfaces-and-blocks-retry",
      "description": "WebSocket stream failures should send an error frame, avoid done, mark the session interrupted, and reject retries until explicit recovery.",
      "runtime": {
        "memory_mode": "local",
        "finalize_active_sessions_on_close": false,
        "speculative_memory_prefetch": false
      },
      "steps": [
        {
          "type": "api_chat_stream",
          "thread_id": "{run_id}-ws-fail",
          "user_id": "{run_id}-user",
          "message": "Stream a supportive reply and then fail.",
          "scripted": {
            "response_chunks": ["partial streamed text"],
            "raise_after_stream_chunks": true,
            "error": "scripted stream failure"
          },
          "expected": {
            "accepted": true,
            "close_code": 1011,
            "done_count": 0,
            "error_code": "agent_turn_failed",
            "status_after": "interrupted",
            "has_active_session": false,
            "event_types_contains": ["chunk", "error"],
            "event_types_not_contains": ["done"],
            "chunk_text_contains": ["partial streamed text"]
          }
        },
        {
          "type": "api_chat_stream",
          "thread_id": "{run_id}-ws-fail",
          "user_id": "{run_id}-user",
          "message": "Retry the interrupted stream before recovery.",
          "expected": {
            "accepted": true,
            "close_code": 1008,
            "done_count": 0,
            "error_code": "session_interrupted",
            "status_after": "interrupted",
            "has_active_session": false,
            "event_types_contains": ["error"],
            "event_types_not_contains": ["done"]
          }
        },
        {
          "type": "api_end",
          "thread_id": "{run_id}-ws-fail",
          "expected": {
            "status_code": 200,
            "status_after": "absent",
            "has_active_session": false
          }
        }
      ]
    }
  ]
}
