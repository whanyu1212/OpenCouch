{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "agent": {
      "root": "apps/agent",
      "framework": "fastapi",
      "functions": {
        "src/asgi.py": {
          "maxDuration": 120,
          "excludeFiles": "{tests/**,evals/**,scripts/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "agent" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
